    <string name="onboarding_goal_keyword_hint">सामग्री अनुशंसाओं के लिए उपयोग किया जाता है</string>

    <!-- Step 3: Setup Habit -->
    <string name="onboarding_habit_title">अपनी पहली आदत सेट करें</string>
    <string name="onboarding_habit_description">30 दिनों में बनाने के लिए एक दैनिक सूक्ष्म-आदत तय करें। जब ध्यान भटकाने वाले ऐप्स रोके जाएँगे तो यह इंटरसेप्ट ओवरले में दिखाई देगी।</string>
    <string name="onboarding_habit_icon_content_description">आदत</string>
    <string name="onboarding_habit_label">दैनिक आदत</string>
    <string name="onboarding_habit_placeholder">जैसे, 10 मिनट पढ़ें</string>
    <string name="onboarding_habit_char_count">%1$d/200</string>

    <!-- Step 5: Done -->
    <string name="onboarding_done_title">आप पूरी तरह तैयार हैं!</string>
    <string name="onboarding_done_description">आपके लक्ष्य और आदतें तैयार हैं। DopaShift आपके स्क्रीन समय को ट्रैक करेगा, ध्यान भटकाने वाले ऐप्स को रोकेगा और हर दिन बेहतर आदतें बनाने में मदद करेगा।\n\nअपनी यात्रा शुरू करने के लिए \"शुरू करें\" पर टैप करें।</string>
    <string name="onboarding_done_icon_content_description">सब तैयार</string>

