    <!-- Step 1: Welcome -->
    <string name="onboarding_welcome_title">DopaShift में आपका स्वागत है</string>
    <string name="onboarding_welcome_description">अपने स्क्रीन समय पर नियंत्रण रखें और सकारात्मक आदतें बनाएँ। DopaShift आपको जीवन के लक्ष्य तय करने, ध्यान भटकाने वाले ऐप्स को रोकने और दैनिक सूक्ष्म-आदतों के साथ अपनी प्रगति ट्रैक करने में मदद करता है।</string>
    <string name="onboarding_welcome_icon_content_description">स्वागत है</string>

    <!-- Step 2: Profile (full name) -->
    <string name="onboarding_profile_title">हम आपको क्या कहकर बुलाएँ?</string>
    <string name="onboarding_profile_description">अपना पूरा नाम दर्ज करें। आप इसे बाद में सेटिंग्स में देख और बदल सकते हैं।</string>
    <string name="onboarding_profile_icon_content_description">प्रोफ़ाइल</string>
    <string name="onboarding_profile_full_name_label">पूरा नाम</string>
    <string name="onboarding_profile_full_name_placeholder">उदा., Alex Sharma</string>

    <!-- Step 3: Create Goal -->
    <string name="onboarding_goal_title">अपना पहला लक्ष्य बनाएँ</string>
    <string name="onboarding_goal_description">आप क्या हासिल करना चाहते हैं? शुरू करने के लिए एक लक्ष्य निर्धारित करें।</string>
    <string name="onboarding_goal_icon_content_description">लक्ष्य</string>
    <string name="onboarding_goal_name_label">लक्ष्य का नाम</string>
    <string name="onboarding_goal_name_placeholder">जैसे, करियर विकास</string>
    <string name="onboarding_goal_category_label">श्रेणी</string>
    <string name="onboarding_goal_category_placeholder">जैसे, पेशेवर</string>
    <string name="onboarding_goal_keyword_label">कीवर्ड</string>
