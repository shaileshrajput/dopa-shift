    <string name="permission_check_status">स्थिती तपासा</string>
    <string name="permission_all_granted">सर्व परवानग्या दिल्या — तुम्ही तयार आहात!</string>
    <string name="permission_grant">द्या</string>
    <string name="permission_granted_label">दिली</string>

