    <!-- Step 1: Welcome -->
    <string name="onboarding_welcome_title">DopaShift मध्ये स्वागत आहे</string>
    <string name="onboarding_welcome_description">तुमच्या स्क्रीन वेळेवर नियंत्रण मिळवा आणि सकारात्मक सवयी तयार करा. DopaShift तुम्हाला जीवनाची ध्येये ठरवण्यास, विचलित करणारे ॲप्स रोखण्यास आणि दैनंदिन सूक्ष्म-सवयींसह तुमची प्रगती ट्रॅक करण्यास मदत करते.</string>
    <string name="onboarding_welcome_icon_content_description">स्वागत आहे</string>

    <!-- Step 2: Profile (full name) -->
    <string name="onboarding_profile_title">तुम्हाला काय म्हणू?</string>
    <string name="onboarding_profile_description">तुमचे पूर्ण नाव प्रविष्ट करा. तुम्ही नंतर सेटिंग्जमध्ये ते पाहू आणि बदलू शकता.</string>
    <string name="onboarding_profile_icon_content_description">प्रोफाइल</string>
    <string name="onboarding_profile_full_name_label">पूर्ण नाव</string>
    <string name="onboarding_profile_full_name_placeholder">उदा., Alex Sharma</string>

    <!-- Step 3: Create Goal -->
    <string name="onboarding_goal_title">तुमचे पहिले ध्येय तयार करा</string>
    <string name="onboarding_goal_description">तुम्हाला काय साध्य करायचे आहे? सुरू करण्यासाठी एक ध्येय ठरवा.</string>
    <string name="onboarding_goal_icon_content_description">ध्येय</string>
    <string name="onboarding_goal_name_label">ध्येयाचे नाव</string>
    <string name="onboarding_goal_name_placeholder">उदा., करिअर वाढ</string>
    <string name="onboarding_goal_category_label">श्रेणी</string>
    <string name="onboarding_goal_category_placeholder">उदा., व्यावसायिक</string>
