    <string name="onboarding_goal_keyword_hint">सामग्री शिफारशींसाठी वापरले जाते</string>

    <!-- Step 3: Setup Habit -->
    <string name="onboarding_habit_title">तुमची पहिली सवय सेट करा</string>
    <string name="onboarding_habit_description">30 दिवसांत तयार करण्यासाठी एक दैनंदिन सूक्ष्म-सवय ठरवा. विचलित करणारे ॲप्स रोखले जातात तेव्हा ती इंटरसेप्ट ओव्हरलेमध्ये दिसेल.</string>
    <string name="onboarding_habit_icon_content_description">सवय</string>
    <string name="onboarding_habit_label">दैनंदिन सवय</string>
    <string name="onboarding_habit_placeholder">उदा., 10 मिनिटे वाचा</string>
    <string name="onboarding_habit_char_count">%1$d/200</string>

    <!-- Step 5: Done -->
    <string name="onboarding_done_title">तुम्ही पूर्ण तयार आहात!</string>
    <string name="onboarding_done_description">तुमची ध्येये आणि सवयी तयार आहेत. DopaShift तुमचा स्क्रीन वेळ ट्रॅक करेल, विचलित करणारे ॲप्स रोखेल आणि दररोज चांगल्या सवयी तयार करण्यास मदत करेल.\n\nतुमचा प्रवास सुरू करण्यासाठी \"सुरू करा\" वर टॅप करा.</string>
    <string name="onboarding_done_icon_content_description">सर्व तयार</string>

