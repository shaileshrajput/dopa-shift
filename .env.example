# =============================================================================
# DopaShift — Local Development Environment Variables
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dopashift
POSTGRES_USER=dopashift
POSTGRES_PASSWORD=dopashift_dev_pass

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# --- Keycloak ---
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass
KEYCLOAK_REALM=dopashift
KEYCLOAK_CLIENT_ID=dopashift-api
KEYCLOAK_CLIENT_SECRET=dopashift-client-secret

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_dev_pass
MINIO_BUCKET=dopashift

# --- API Instances ---
API_PORT_1=8080
API_PORT_2=8081

# --- Nginx Load Balancer ---
NGINX_PORT=80

# --- OpenTelemetry Collector ---
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# --- Prometheus ---
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_pass

# --- Loki ---
LOKI_HOST=loki
LOKI_PORT=3100
